diff --git a/pdf2htmlEX/src/util/ffw.c b/pdf2htmlEX/src/util/ffw.c
index 7f99a78..a12992d 100644
--- a/pdf2htmlEX/src/util/ffw.c
+++ b/pdf2htmlEX/src/util/ffw.c
@@ -411,6 +411,59 @@ void ffw_get_metric(double * ascent, double * descent)
     ffwClearAction();
 }
 
+static int unicode_cmp(const void * a, const void * b)
+{
+    int32_t x = *(const int32_t *)a, y = *(const int32_t *)b;
+    return (x > y) - (x < y);
+}
+
+static int glyph_is_used(SplineChar * sc, const int32_t * unicodes, int count)
+{
+    if((sc->unicodeenc >= 0)
+        && bsearch(&sc->unicodeenc, unicodes, count, sizeof(int32_t), unicode_cmp))
+        return 1;
+    for(struct altuni * alt = sc->altuni; alt; alt = alt->next)
+    {
+        if(bsearch(&alt->unienc, unicodes, count, sizeof(int32_t), unicode_cmp))
+            return 1;
+    }
+    return 0;
+}
+
+void ffw_get_used_metric(const int32_t * unicodes, int count, double * ascent, double * descent)
+{
+    ffwSetAction("get the used metric of");
+    SplineFont * sf = cur_fv->sf;
+    int em = sf->ascent + sf->descent;
+    double maxy = 0, miny = 0;
+    int found = 0;
+
+    for(int i = 0; i < sf->glyphcnt; ++i)
+    {
+        SplineChar * sc = sf->glyphs[i];
+        if((sc == NULL) || !glyph_is_used(sc, unicodes, count))
+            continue;
+
+        DBounds bb;
+        SplineCharFindBounds(sc, &bb);
+        if((bb.minx == bb.maxx) && (bb.miny == bb.maxy))
+            continue; // no outline, e.g. space
+
+        if(!found || (bb.maxy > maxy)) maxy = bb.maxy;
+        if(!found || (bb.miny < miny)) miny = bb.miny;
+        found = 1;
+    }
+    ffwClearAction();
+
+    if(!found || (em <= 0))
+    {
+        ffw_get_metric(ascent, descent);
+        return;
+    }
+    *ascent = maxy / em;
+    *descent = miny / em;
+}
+
 void ffw_set_metric(double ascent, double descent)
 {
     ffwSetAction("set the metric of");
