<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    LaunchAgent for the pdf_viewer FastAPI daemon.

    Symlinked into ~/Library/LaunchAgents/ so edits here propagate on reload
    without needing to re-copy. Loaded once via:

        launchctl bootstrap gui/$UID \
            ~/Library/LaunchAgents/com.anders.pdf_viewer.plist

    Uninstall:

        launchctl bootout gui/$UID/com.anders.pdf_viewer

    Force restart after editing:

        launchctl kickstart -k gui/$UID/com.anders.pdf_viewer

    Logs stream to ~/.cache/pdf_viewer/daemon.log (shared with the convert
    scripts' log directory; separate filename so conversion output stays
    grep-able).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anders.pdf_viewer</string>

    <!--
        Sync the daemon's venv, then exec uvicorn so it IS the job's process.
        Under `uv run`, launchd's SIGTERM on restart reached uv but not its
        uvicorn child, which lived on as an orphan still answering the
        extension's long-poll.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/Users/andersbekkevard/.local/bin/uv sync --directory /Users/andersbekkevard/dev/misc/pdf_viewer/daemon --quiet &amp;&amp; exec /Users/andersbekkevard/dev/misc/pdf_viewer/daemon/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 7435</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>WorkingDirectory</key>
    <string>/Users/andersbekkevard/dev/misc/pdf_viewer/daemon</string>

    <key>StandardOutPath</key>
    <string>/Users/andersbekkevard/.cache/pdf_viewer/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/andersbekkevard/.cache/pdf_viewer/daemon.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/andersbekkevard/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/andersbekkevard</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
